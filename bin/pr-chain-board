<script type="module">
const STEPS=['Update Branch','Review','Fix','Audit','UI Review','Human Gate','CI','Merge'],SHORT=['Update','Review','Fix','Audit','UI','Gate','CI','Merge'],N=STEPS.length;
const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const stage=$('stage');
const labs=STEPS.map((n,i)=>{const d=document.createElement('div');d.className='lab';d.innerHTML=`<div class="n"><span class="lg">${n}</span><span class="sh">${SHORT[i]}</span></div><div class="s"></div>`;stage.appendChild(d);return d});
const view={states:Array(N).fill('pending'),active:-1,loop:false,idle:true};

function laneStates(c){const st=Array(N).fill('pending'),last={};(c.done||[]).forEach(d=>last[d.step]=d);const ai=STEPS.indexOf(c.step);
 STEPS.forEach((n,i)=>{const d=last[n];if((n==='UI Review'||n==='Human Gate')&&!c.ui)st[i]='skip';else if(i===ai)st[i]='active';
  else if(d)st[i]=/FAIL|RED|None/.test(String(d.verdict||''))?'fail':'done'});return st}
function nodeStates(s){const c=s.current,st=Array(N).fill('pending'),sub=Array(N).fill('');let ai=-1;
 if(c){const last={};c.done.forEach(d=>last[d.step]=d);ai=STEPS.indexOf(c.step);
  STEPS.forEach((n,i)=>{const d=last[n];
   if((n==='UI Review'||n==='Human Gate')&&!c.ui){st[i]='skip'}
   else if(i===ai){st[i]='active';sub[i]=n==='Review'||n==='Fix'?'round '+(c.round||1):n==='UI Review'&&c.agent&&c.agent.role==='fix'?'fixing':'running'}
   else if(d){const v=String(d.verdict||'');st[i]=/FAIL|RED|None/.test(v)?'fail':'done';sub[i]=((v&&v!=='ok'?v.split(/[\s;:,(]/)[0]+' ':'')+d.ts).toLowerCase()}})}
 view.lanes=s.lanes||[];
 view.states=st;view.active=ai;view.idle=!c;view.loop=!!c&&(c.step==='Fix'||(c.step==='Review'&&(c.round||1)>1));
 labs.forEach((l,i)=>{l.className='lab '+st[i];l.lastChild.textContent=sub[i]})}

let feedKey='',curPr=0,prRows=null,isRows=null;
const low=s=>String(s||'').toLowerCase().replace(/_/g,' ');
const ago=t=>{const s=(Date.now()-new Date(t))/1e3;return s<3600?Math.max(1,Math.round(s/60))+'m':s<86400?Math.round(s/3600)+'h':Math.round(s/86400)+'d'};
const vcls=v=>/PASS|APPROVED|^READY|SUCCESS|MERGED|CLEAN/.test(v)?'ok':/FAIL|CHANGES|NOT READY|ERROR|DIRTY|CONFLICT/.test(v)?'bad':/HUMAN|POLICY|BEHIND|BLOCKED|TIMEOUT|UNSTABLE|REVIEW_REQUIRED|DRAFT/.test(v)?'warn':'dim';
const tk=n=>n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e3?Math.round(n/1e3)+'k':String(n||0);
const us=n=>n?' · ~$'+(n>=100?Math.round(n):n>=0.01?n.toFixed(2):'0.01'):'';
const w=(t,c)=>`<span class="${c||''}">${esc(t)}</span>`;
function prBits(p){const b=[];
 if(p.n===curPr||p.chain==='running')b.push(w('in the chain now','ok'));else if(p.chain)b.push(w(low(p.chain),vcls(String(p.chain).toUpperCase())));
 if(p.fail)b.push(w(p.fail+' failing','bad'));else if(p.wait)b.push(w('checks running'));
 if(p.merge==='DIRTY')b.push(w('conflict','bad'));else if(p.merge==='BEHIND')b.push(w('behind main','warn'));
 if(p.draft)b.push(w('draft'));else if(!b.length)b.push(p.review==='APPROVED'?w('approved','ok'):p.ok?w('checks green'):w('no checks'));
 return b.join(' · ')}
function paintPrs(){if(!prRows)return;const r=prRows,f=r.filter(p=>p.fail).length,h=r.filter(p=>/AWAIT-HUMAN|POLICY-HOLD|NEEDS-PERSON|STUCK/.test(String(p.chain).toUpperCase())).length,d=r.filter(p=>p.draft).length;
 $('prc').innerHTML=[r.length+' open',f?w(f+' failing checks','bad'):'',h?w(h+' need you','warn'):'',d?d+' drafts':''].filter(Boolean).join(' · ');
 $('prl').innerHTML=r.length?r.map(p=>`<a class="lr${p.n===curPr?' now':''}" href="/prs#${p.n}" title="${esc(p.title)}"><span class="k">#${p.n}</span><span class="t">${esc(p.title)}</span><span class="s">${prBits(p)}${p.tok?' · '+tk(p.tok)+us(p.usd):''}</span><span class="a">${ago(p.at)}</span></a>`).join(''):'<div class="dim">No open pull requests.</div>'}
function isBits(i){if(i.chain==='building')return w('in the chain now','ok');if(i.prs&&i.prs.length)return i.prs.map(q=>w('PR #'+q.n)+(q.chain?' '+w(low(q.chain),vcls(String(q.chain).toUpperCase())):'')).join(' · ');
 const l=i.labels.filter(x=>!/triage/.test(x)).slice(0,2).join(', ');return w(l||'no labels')}
function paintIs(){if(!isRows)return;const r=isRows,b=r.filter(i=>i.labels.includes('bug')).length,n=r.filter(i=>!(i.prs&&i.prs.length)).length,top=[...r.filter(i=>i.chain==='building'),...r.filter(i=>i.chain!=='building')].slice(0,40);
 $('isc').innerHTML=[r.length+' open',b?b+' bugs':'',n?n+' without a pull request':''].filter(Boolean).join(' · ');
 $('isl').innerHTML=r.length?top.map(i=>`<a class="lr" href="/issues#${i.n}" title="${esc(i.title)}"><span class="k">#${i.n}</span><span class="t">${esc(i.title)}</span><span class="s">${isBits(i)}${i.tok?' · '+tk(i.tok)+us(i.usd):''}</span><span class="a">${ago(i.at)}</span></a>`).join('')+(r.length>top.length?`<a class="more" href="/issues">All ${r.length} Open Issues</a>`:''):'<div class="dim">No open issues.</div>'}
async function lists(){const get=async u=>{try{const d=await (await fetch(u)).json();return d.error?null:d}catch(e){return null}};
 const [a,b]=await Promise.all([get('/api/prs?state=open'),get('/api/issues?state=open')]);
 if(a){prRows=a.prs;paintPrs()}else if(!prRows)$('prl').innerHTML='<div class="dim">GitHub did not answer. Trying again in a minute.</div>';
 if(b){isRows=b.issues;paintIs()}else if(!isRows)$('isl').innerHTML='<div class="dim">GitHub did not answer. Trying again in a minute.</div>'}
function feed(a){const el=$('feed'),ev=(a&&a.events)||[];
 $('who').textContent=a&&a.dir?a.dir+(a.idle!=null?(a.idle<90?' · writing now':' · quiet '+Math.max(1,Math.round(a.idle/60))+' min'):''):'';
 $('who').className=a&&a.idle!=null&&a.idle<90?'live':'';
 const S=window.lastS||{},lv=S.live||[],cp=S.current?S.current.pr:0;if(agPick&&!lv.includes(agPick))agPick=0;
 $('agsw').innerHTML=lv.length>1?lv.map(n=>`<button class="${n===cp?'on':''}" data-pr="${n}" title="Show this chain's agent">#${n}</button>`).join(''):'';
 const key=(a?a.dir:'')+ev.length+(ev.length?ev[ev.length-1].t.length:0);if(key===feedKey)return;feedKey=key;
 const stick=el.scrollHeight-el.scrollTop-el.clientHeight<60;let lastSay=-1;ev.forEach((e,i)=>{if(e.k==='say')lastSay=i});
 el.innerHTML=ev.length?ev.map((e,i)=>`<div class="e ${e.k}${i===lastSay?' last':''}">${esc(e.t)}</div>`).join(''):'<div class="dim">No agent output yet.</div>';
 if(stick)el.scrollTop=el.scrollHeight}

const BUILD='__BUILD__';
let agPick=0;
document.addEventListener('click',e=>{const b=e.target.closest('#agsw button');if(!b)return;agPick=+b.dataset.pr;feedKey='';tick()});
window.startLoop=async function(b){  // module script: inline onclick needs it on window
b.disabled=true;b.textContent='Starting';try{const r=await fetch('/api/loop',{method:'POST',headers:{'Content-Type':'application/json'},body:'{"action":"start"}'});if(!r.ok)b.textContent='Failed: '+((await r.json()).error||r.status)}catch(e){b.textContent='Failed'}setTimeout(tick,1500)}
async function tick(){let s;try{s=window.lastS=await (await fetch('/api/state'+(agPick?'?pr='+agPick:''))).json()}catch(e){$('meta').innerHTML='<b class="off">Board server not answering</b>';return}
 if(s.error){$('meta').innerHTML='<b class="warn">'+esc(s.error)+'</b>';return}
 if(s.build&&s.build!==BUILD){try{if(sessionStorage.getItem('rl')!==s.build){sessionStorage.setItem('rl',s.build);location.reload();return}}catch(e){}}
 const c=s.current;if((c?c.pr:0)!==curPr){curPr=c?c.pr:0;paintPrs()}
 $('meta').innerHTML=`<span>Loop <b class="${s.loop_on?'on':'off'}">${s.loop_on?'running':'not running'}</b>${s.loop_on?'':' <button class="startloop" onclick="startLoop(this)" title="Starts pr-chain-loop in the background, logging to logs/loop.log. Clears a stop request first.">Start Loop</button>'}</span><span>Chain <b class="${s.chain_on?'on':''}">${s.chain_on?'working':'idle'}</b></span>${s.building!=null?`<span>Building <b class="on">${(s.building_all||[]).length?s.building_all.map(n=>'#'+n).join(' '):'an issue'}</b>`:''}</span>${s.stop?'<span><b class="warn">stop requested</b></span>':''}<span>Main-drift refolds today <b>${s.drift_today}</b></span><span title="${s.tok.runs} agent runs today${s.tok.missing?', '+s.tok.missing+' with no count in their log':''}"><a href="/spend">Tokens today</a> <b>${tk(s.tok.today)}</b>${us(s.tok.usd)}</span><span>${s.now}</span>`;
 $('cur').className='pr'+(c?'':' idle');
 $('cur').innerHTML=c?`<span class="num"><a href="/prs#${c.pr}">#${c.pr}</a></span><span class="title">${esc(c.title.replace(/^#?\d+:\s*/,''))}</span><span class="facts">head ${esc(c.head)} · started ${esc(c.started)} · ${c.ui?'UI PR, stops for your review':'no UI, merges after Audit and CI'} · <span title="${esc((c.tok_runs||[]).map(r=>r.ts+' '+r.role+' '+r.model+' '+(r.tok==null?'no count':tk(r.tok)+us(r.usd))).join('\n'))}">${tk(c.tok)} tokens so far${us(c.usd)}</span></span>`:`<span class="title">No PR in flight${s.loop_on?'. The loop is between PRs or waiting for a free one.':''}</span>`;
 nodeStates(s);feed(c&&c.agent);
 const q=s.queue.filter(x=>!c||x.pr!==c.pr);let nx=false;
 $('queue').innerHTML=s.queue.length?'<table>'+q.map(x=>{const free=x.owner==='FREE',n=free&&!nx;if(n)nx=true;
  return `<tr class="${n?'next':''}"><td class="k"><a href="/prs#${x.pr}">#${x.pr}</a></td><td class="d">${x.ui?'UI':''}</td><td class="d">${x.size} lines</td><td class="d">${esc(x.state.toLowerCase())}</td><td class="${free?'':'f'}">${n?'next, updates its branch first':free?'free':esc(x.owner)}</td></tr>`}).join('')+'</table>':'<div class="dim">Loading the PR list…</div>';
 $('problems').innerHTML=(s.problems||[]).length?'<table>'+s.problems.map(q=>`<tr><td class="k">${q.pr?`<a href="/prs#${q.pr}">#${q.pr}</a>`:''}</td><td class="k ${q.kind==='needs-you'||q.kind==='loop-down'?'warn':q.kind==='resting'?'dim':'bad'}">${esc(String(q.kind).replace(/-/g,' '))}</td><td><div class="why">${esc(q.what)}</div></td><td class="f k">${esc(q.action)}</td></tr>`).join('')+'</table>':'<div class="why">No Problems Found</div>';
 $('ended').innerHTML='<table>'+s.ended.map(e=>`<tr><td class="k"><a href="/prs#${e.pr}">#${e.pr}</a></td><td class="k ${e.status==='MERGED'?'ok':/HUMAN|POLICY/.test(e.status)?'warn':/RESTING|CLOSED/.test(e.status)?'dim':'bad'}">${esc(String(e.status).toLowerCase())}</td><td class="f k">${esc(e.ts)}</td><td class="f k" title="Tokens this chain run used, with its API-rate estimate">${e.tok?tk(e.tok)+us(e.usd):''}</td><td><div class="why">${esc(e.why)}</div></td></tr>`).join('')+'</table>';
 const lg=$('log'),bot=lg.scrollHeight-lg.scrollTop-lg.clientHeight<30;lg.textContent=s.log.map(l=>l.replace(/cwd=\S+/,'').slice(0,150)).join('\n');if(bot)lg.scrollTop=lg.scrollHeight}
const root=document.documentElement,side=document.querySelector('.side'),grid=document.querySelector('.grid');
const box=id=>({get:()=>$(id).offsetHeight,min:40,max:()=>1400,set:v=>{$(id).style.height=v==null?'':v+'px';$(id).style.maxHeight=v==null?'':'none'}});
const RZ={sh:{get:()=>stage.offsetHeight,min:110,max:()=>innerHeight*.6,set:v=>v==null?root.style.removeProperty('--sh'):root.style.setProperty('--sh',v+'px')},
 sw:{x:1,get:()=>side.offsetWidth,min:240,max:()=>grid.offsetWidth-340,set:v=>v==null?root.style.removeProperty('--gc'):root.style.setProperty('--gc',`minmax(0,1fr) 26px ${v}px`)},
 qh:box('queue'),ph:box('prl'),ih:box('isl'),eh:box('ended'),lh:box('log'),
 fh:{get:()=>$('feed').offsetHeight,min:120,max:()=>2400,set:v=>{const f=$('feed').style;f.height=v==null?'':v+'px';f.flex=v==null?'':'none';f.minHeight=v==null?'':'0';f.maxHeight=v==null?'':'none'}}};
const tg=$('tg');let noTools=false;try{noTools=localStorage.getItem('board.tools')==='0'}catch(e){}
const paintTg=()=>{$('feed').classList.toggle('nt',noTools);tg.textContent=noTools?'Show Tools':'Hide Tools'};paintTg();
tg.addEventListener('click',()=>{noTools=!noTools;try{localStorage.setItem('board.tools',noTools?'0':'1')}catch(e){}paintTg();const f=$('feed');f.scrollTop=f.scrollHeight});
let sizes={};try{sizes=JSON.parse(localStorage.getItem('board.rz')||'{}')}catch(e){}
const keep=()=>{try{localStorage.setItem('board.rz',JSON.stringify(sizes))}catch(e){}};
for(const k in sizes)if(RZ[k])RZ[k].set(sizes[k]);
document.querySelectorAll('.rz').forEach(h=>{const k=h.dataset.rz,r=RZ[k];let a=null;
 h.addEventListener('pointerdown',e=>{a={p:r.x?e.clientX:e.clientY,v:r.get()};h.setPointerCapture(e.pointerId);h.classList.add('on');e.preventDefault()});
 h.addEventListener('pointermove',e=>{if(!a)return;const d=(r.x?e.clientX:e.clientY)-a.p,v=Math.round(Math.max(r.min,Math.min(r.max(),a.v+(r.x?-d:d))));sizes[k]=v;r.set(v)});
 const end=()=>{if(a){a=null;h.classList.remove('on');keep()}};h.addEventListener('pointerup',end);h.addEventListener('pointercancel',end);
