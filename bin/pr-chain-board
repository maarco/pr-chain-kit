"""
# an open tab (a phone on the VPN) keeps the CSS it loaded; /api/state carries this token and the tab reloads itself once when it changes
BUILD = hashlib.sha1(PAGE.encode()).hexdigest()[:10]

CHECKOUT = CONF.checkout
PRS_PAGE = PC / "board" / "prs.html"
ISSUES_PAGE = PRS_PAGE.with_name("issues.html")
ILIST_FIELDS = "number,title,author,labels,state,stateReason,assignees,updatedAt,createdAt,closedAt,closedByPullRequestsReferences"
IVIEW_FIELDS = ILIST_FIELDS + ",body,comments,milestone,url"
GH = next((g for g in ("/opt/homebrew/bin/gh", "/usr/local/bin/gh") if os.path.exists(g)), "gh")
gh_cache = {}
LIST_FIELDS = "number,title,author,headRefName,isDraft,state,mergeStateStatus,reviewDecision,labels,updatedAt,additions,deletions,changedFiles,statusCheckRollup,mergedAt,closedAt"
VIEW_FIELDS = ("number,title,body,author,state,isDraft,headRefName,baseRefName,headRefOid,mergeable,mergeStateStatus,reviewDecision,labels,additions,"
               "deletions,changedFiles,files,commits,comments,reviews,statusCheckRollup,closingIssuesReferences,url,createdAt,updatedAt,mergedAt,closedAt")
HTMLC = re.compile(r"<!--.*?-->", re.S)
MARKER = re.compile(r"<!--\s*pr-chain:([a-z-]+)")
TAGS = {"ui-verdict": "UI Review", "verdict": "Review", "gate-verdict": "Audit", "audit": "Audit", "addendum": "Addendum", "review": "Review"}


gh_busy = set()
GH_CACHE_FILE = WORK / "board-gh-cache.json"  # survives a board restart: the first page load reads this, not GitHub
try:
    gh_cache.update({k: tuple(v) for k, v in json.loads(GH_CACHE_FILE.read_text()).items()})
except (OSError, ValueError):
    pass


def gh_save():
    try:
        tmp = GH_CACHE_FILE.with_suffix(f".tmp{threading.get_ident()}")
        tmp.write_text(json.dumps({k: list(v) for k, v in list(gh_cache.items()) if not k.startswith("diff:")}))
        tmp.replace(GH_CACHE_FILE)
    except (OSError, TypeError, ValueError):
        pass


def gh_fetch(key, args):
    p = subprocess.run([GH, *args], cwd=str(CHECKOUT), capture_output=True, text=True, timeout=60)
    if p.returncode:
        raise RuntimeError((p.stderr or "gh failed").strip()[:300])
    data = json.loads(p.stdout or "null")
    gh_cache[key] = (time.time(), data)
    gh_save()
    return data


def gh_refresh(key, args):
    try:
        gh_fetch(key, args)
    except Exception:
        pass
    finally:
        gh_busy.discard(key)


STALE_MAX = 600  # a saved GitHub answer older than this is never shown first: the request waits for GitHub (the old answer is the fallback on a gh failure)


def gh_json(key, ttl, args, fresh=False):
    """Read-only gh call, cached. A stale answer is served at once while a background thread refetches it,
    so only the first read of a key (or fresh=True) waits on GitHub. On a gh failure the last good answer is reused."""
    hit = gh_cache.get(key)
    if hit and not fresh and time.time() - hit[0] < STALE_MAX:
        if time.time() - hit[0] >= ttl and key not in gh_busy:
            gh_busy.add(key)
            threading.Thread(target=gh_refresh, args=(key, args), daemon=True).start()
        return hit[1]
    try:
        return gh_fetch(key, args)
    except Exception:
        if hit:
            return hit[1]
        raise


def pr_diff(n, fresh=False):
    """Unified diff of one PR, split per file (read-only `gh pr diff`, cached 60 s)."""
    key = f"diff:{n}"
    hit = gh_cache.get(key)
    if hit and not fresh and time.time() - hit[0] < 60:
        return hit[1]
    p = subprocess.run([GH, "pr", "diff", str(n)], cwd=str(CHECKOUT), capture_output=True, text=True, errors="replace", timeout=90)
    if p.returncode:
        if hit:
            return hit[1]
        raise RuntimeError((p.stderr or "gh failed").strip()[:300])
    files = {}
    for chunk in re.split(r"(?m)^(?=diff --git )", p.stdout):
        m = re.match(r"diff --git a/(.*?) b/(.*)\n", chunk)
        if not m:
            continue
        lines = chunk.split("\n")
        start = next((i for i, ln in enumerate(lines) if ln.startswith("@@")), None)
        if start is None:
            note_ = next((ln for ln in lines[1:] if ln.startswith(("Binary", "rename", "similarity", "deleted", "new file"))), "No text changes.")
            files[m.group(2)] = dict(lines=[], note=note_, cut=0)
            continue
        body = lines[start:]
        if body and body[-1] == "":
            body.pop()
        files[m.group(2)] = dict(lines=body[:2500], note="", cut=max(0, len(body) - 2500))
    data = dict(pr=n, files=files)
    gh_cache[key] = (time.time(), data)
    return data


def checks(rollup, full=False):
    out = dict(ok=0, fail=0, wait=0, skip=0, items=[])
    for c in rollup or []:
        name = c.get("name") or c.get("context") or "?"
        res = (c.get("conclusion") or c.get("state") or "").upper()
        done = c.get("status", "COMPLETED") == "COMPLETED"
        if not done or res in ("PENDING", "EXPECTED", ""):
            k = "wait"
        elif res in ("SUCCESS", "NEUTRAL"):
            k = "ok"
        elif res in ("SKIPPED",):
            k = "skip"
        else:
            k = "fail"
        out[k] += 1
        if full and k in ("fail", "wait"):
            out["items"].append(dict(name=name, flow=c.get("workflowName") or "", k=k, res=res.lower() or "running", url=c.get("detailsUrl") or c.get("targetUrl") or ""))
    return out


def chain_state(n):
    try:
        return json.loads((WORK / "prs" / str(n) / "STATE.json").read_text())
    except Exception:
        return None


def pr_list(which, fresh=False):
    which = which if which in ("open", "merged", "closed") else "open"
    rows = gh_json("list:" + which, 60, ["pr", "list", "--state", which, "--limit", "40", "--json", LIST_FIELDS], fresh)
    pick = {q["pr"]: q for q in pick_cache["rows"]}
    ptok = tok_maps()[0]
    out = []
    for r in rows:
        n = r["number"]
        st = chain_state(n) or {}
        c = checks(r.get("statusCheckRollup"))
        out.append(dict(n=n, title=r["title"], author=(r.get("author") or {}).get("login", ""), branch=r["headRefName"], draft=r["isDraft"],
                        state=r["state"], merge=r.get("mergeStateStatus") or "", review=r.get("reviewDecision") or "",
                        labels=[x["name"] for x in r.get("labels") or []], at=r.get("mergedAt") or r.get("closedAt") or r["updatedAt"],
                        add=r["additions"], rem=r["deletions"], files=r["changedFiles"], ok=c["ok"], fail=c["fail"], wait=c["wait"],
                        chain=st.get("status", ""), ui=pick.get(n, {}).get("ui"), owner=pick.get(n, {}).get("owner", ""), tok=ptok.get(n, 0),
                        usd=usd_maps()[0].get(n, 0)))
    out.sort(key=lambda x: x["at"], reverse=True)
    return dict(state=which, prs=out, age=int(time.time() - gh_cache["list:" + which][0]))


def note(who, at, kind, body, url="", extra=""):
    raw = body or ""
    m = MARKER.search(raw)
    text = HTMLC.sub("", raw).strip()
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    first = next((ln for ln in lines if not re.fullmatch(r"(PASS|FAIL)", ln)), lines[0] if lines else "")
    v = re.search(r"\b(NOT READY|PASS|FAIL|READY|APPROVED|CHANGES_REQUESTED)\b", extra + " " + text[:400])
    return dict(who=who, at=at, kind=kind, tag=TAGS.get(m.group(1), m.group(1).replace("-", " ").title()) if m else "", verdict=v.group(1) if v else "",
                first=re.sub(r"^#+\s*", "", first)[:220], body=text[:9000], long=len(lines) > 1 or len(first) > 220, url=url, extra=extra)


def pr_detail(n, fresh=False):
    hit, sp = gh_cache.get(f"pr:{n}"), WORK / "prs" / str(n) / "STATE.json"
    # A cached GitHub copy older than the chain's last write holds an older head; the page would call that head a new push.
    fresh = fresh or bool(hit and sp.exists() and sp.stat().st_mtime > hit[0])
    d = gh_json(f"pr:{n}", 45, ["pr", "view", str(n), "--json", VIEW_FIELDS], fresh)
    try:
        inline = gh_json(f"inline:{n}", 45, ["api", f"repos/{{owner}}/{{repo}}/pulls/{n}/comments", "--paginate"], fresh)
    except Exception:
        inline = []
    thread = [note((c.get("author") or {}).get("login", ""), c["createdAt"], "comment", c.get("body"), c.get("url", "")) for c in d.get("comments") or []]
    for r in d.get("reviews") or []:
        if r.get("body") or r.get("state") != "COMMENTED":
            thread.append(note((r.get("author") or {}).get("login", ""), r.get("submittedAt") or "", "review", r.get("body"), "",
                               f'{r.get("state", "")} at {((r.get("commit") or {}).get("oid") or "")[:8]}'))
    for c in inline or []:
        thread.append(note((c.get("user") or {}).get("login", ""), c.get("created_at", ""), "inline", c.get("body"), c.get("html_url", ""),
                           f'{c.get("path", "")}:{c.get("line") or c.get("original_line") or ""}'))
    thread.sort(key=lambda x: x["at"])
    files = sorted(d.get("files") or [], key=lambda f: -(f.get("additions", 0) + f.get("deletions", 0)))
    commits = d.get("commits") or []
    led = [r for r in ledger_rows(3000) if str(r.get("pr")) == str(n)][-14:]
    return dict(n=d["number"], title=d["title"], url=d["url"], state=d["state"], draft=d["isDraft"], author=(d.get("author") or {}).get("login", ""),
                branch=d["headRefName"], base=d["baseRefName"], head=d["headRefOid"], created=d["createdAt"], updated=d["updatedAt"],
                merged=d.get("mergedAt"), closed=d.get("closedAt"), mergeable=d.get("mergeable") or "", merge=d.get("mergeStateStatus") or "",
                review=d.get("reviewDecision") or "", labels=[x["name"] for x in d.get("labels") or []],
                issues=[dict(n=i["number"], url=i["url"]) for i in d.get("closingIssuesReferences") or []],
                tok=tok_maps()[0].get(n, 0), usd=usd_maps()[0].get(n, 0),
                add=d["additions"], rem=d["deletions"], nfiles=d["changedFiles"],
                files=[dict(path=f["path"], add=f.get("additions", 0), rem=f.get("deletions", 0)) for f in files[:60]],
                ncommits=len(commits), commits=[dict(oid=c["oid"][:8], msg=c.get("messageHeadline", ""), at=c.get("committedDate", "")) for c in commits[-6:]][::-1],
                checks=checks(d.get("statusCheckRollup"), True), body=HTMLC.sub("", d.get("body") or "").strip()[:9000], thread=thread,
                chain=chain_state(n), ui=next((q.get("ui") for q in pick_cache["rows"] if q["pr"] == n), None),
                ledger=[dict(ts=str(r.get("ts", ""))[5:16].replace("T", " "), stage=r.get("stage", ""), role=r.get("role", ""), model=r.get("model", ""),
                             rc=r.get("rc"), secs=r.get("secs"), status=r.get("status", ""), why=str(r.get("why") or "")[:160]) for r in led],
                age=int(time.time() - gh_cache[f"pr:{n}"][0]))


def issue_chain(n):
    """What pr-chain recorded when it built this issue into a pull request (None: never tried)."""
    try:
        st = json.loads((WORK / "issues" / str(n) / "STATE.json").read_text())
        return dict(status=str(st.get("status") or ""), why=str(st.get("why") or "")[:300], pr=st.get("pr"))
    except Exception:
        return None


def issue_row(r):
    return dict(n=r["number"], title=r["title"], author=(r.get("author") or {}).get("login", ""), state=r["state"], reason=r.get("stateReason") or "",
                labels=[x["name"] for x in r.get("labels") or []], who=[a["login"] for a in r.get("assignees") or []],
                at=r["updatedAt"], created=r["createdAt"], closed=r.get("closedAt"),
                prs=[dict(n=q["number"], chain=(chain_state(q["number"]) or {}).get("status", "")) for q in r.get("closedByPullRequestsReferences") or []],
                chain=(issue_chain(r["number"]) or {}).get("status", ""))


def issue_list(which, fresh=False):
    """Read-only `gh issue list`, cached 90 s. Open: up to 300. Closed: the 80 most recent."""
    which = which if which in ("open", "closed") else "open"
    rows = gh_json("ilist:" + which, 90, ["issue", "list", "--state", which, "--limit", "300" if which == "open" else "80", "--json", ILIST_FIELDS], fresh)
    itok = tok_maps()[1]
    iusd = usd_maps()[1]
    out = [dict(issue_row(r), tok=itok.get(r["number"], 0), usd=iusd.get(r["number"], 0)) for r in rows]
    out.sort(key=lambda x: x["at"], reverse=True)
    return dict(state=which, issues=out, age=int(time.time() - gh_cache["ilist:" + which][0]))


def issue_detail(n, fresh=False):
    d = gh_json(f"issue:{n}", 45, ["issue", "view", str(n), "--json", IVIEW_FIELDS], fresh)
    out = issue_row(d)
    out["tok"] = tok_maps()[1].get(n, 0)
    out["usd"] = usd_maps()[1].get(n, 0)
    out["chain"] = issue_chain(n)
    out.update(url=d["url"], milestone=(d.get("milestone") or {}).get("title", ""), body=HTMLC.sub("", d.get("body") or "").strip()[:14000],
               thread=[note((c.get("author") or {}).get("login", ""), c["createdAt"], "comment", c.get("body"), c.get("url", "")) for c in d.get("comments") or []],
               age=int(time.time() - gh_cache[f"issue:{n}"][0]))
    return out


# --- agent runs: the exact prompt and result of every agent that worked on a PR or built an issue (read-only).
# err.txt is never read or served: it holds session tokens. Page code lives in board/runs.js, shared by /prs and /issues. ---
import difflib
from datetime import datetime

RUNS_JS = PC / "board" / "runs.js"
RUN_RESULT = {"review": "verdict.md", "gate": "verdict.md", "ui": "ui-verdict.md", "fix": "fix-report.md", "build": "build-report.md"}
RUN_ID = re.compile(r"p(\d+)/([A-Za-z0-9][A-Za-z0-9._-]*)|i(\d+)")
BRIEF_HEAD = re.compile(r"[Pp]inned head:?\s*`?([0-9a-f]{12,40})|^head ([0-9a-f]{12,40})", re.M)


def _local(iso):
    """GitHub's UTC time as the local wall-clock string the ledger uses."""
    return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().replace(tzinfo=None).isoformat(timespec="seconds")


def _full_ledger():
    rows = []
    try:
        for ln in (WORK / "ledger.jsonl").read_text(errors="replace").splitlines():
            try:
                rows.append(json.loads(ln))
            except ValueError:
                pass
    except OSError:
        pass
    return rows


def _run_row(rid, name, d, agents):
    role = "build" if rid[0] == "i" else name.split(".")[0].rsplit("-", 1)[-1]
    brief = (d / "brief.md").read_text(errors="replace")
    files = [f for f in d.iterdir() if f.is_file() and f.name != "err.txt"]
    start, end = (d / "brief.md").stat().st_mtime, max(f.stat().st_mtime for f in files)
    res = d / RUN_RESULT.get(role, "verdict.md")
    first = ((res.read_text(errors="replace").splitlines() or [""])[0][:80]) if res.is_file() else ""
    m = BRIEF_HEAD.search(brief[:6000])
    best = min(agents, key=lambda r: abs(datetime.fromisoformat(r["ts"]).timestamp() - end), default=None)
    near = best is not None and abs(datetime.fromisoformat(best["ts"]).timestamp() - end) < 120
    return dict(id=rid, name=name, role=role, start=datetime.fromtimestamp(start).isoformat(timespec="seconds"),
                end=datetime.fromtimestamp(end).isoformat(timespec="seconds"), first=first, head=((m.group(1) or m.group(2)) if m else "")[:12],
                secs=int(best["secs"]) if near and best.get("secs") else None, model=(best.get("model") or "") if near else "", size=len(brief))


def _agent_rows(*keys):
    """Ledger rows for one agent run each, only for these ledger keys (parallel chains write to the same file)."""
    return [r for r in _full_ledger() if r.get("stage") == "agent" and r.get("ts") and str(r.get("pr")) in keys]


def pr_runs(n):
    built = []  # issues whose build run opened this PR
    for st in (WORK / "issues").glob("*/STATE.json"):
        try:
            if str(json.loads(st.read_text()).get("pr")) == str(n) and (st.parent / "brief.md").is_file():
                built.append(st.parent)
        except (ValueError, OSError):
            pass
    agents = _agent_rows(str(n), *(f"i{d.name}" for d in built))
    base = WORK / "prs" / str(n)
    runs = [_run_row(f"p{n}/{d.name}", d.name, d, agents) for d in sorted(base.iterdir())
            if d.is_dir() and (d / "brief.md").is_file()] if base.is_dir() else []
    runs += [_run_row(f"i{d.name}", "issue build", d, agents) for d in built]
    return sorted(runs, key=lambda r: r["start"])


def _timeline(n, tag=""):
    """Everything except the agent runs themselves (the page draws those as rows of their own, in time order)."""
    ev = []
    for r in _full_ledger():
        if str(r.get("pr")) == str(n) and r.get("stage") != "agent" and r.get("ts"):
            bits = " ".join(f"{k}={str(v)[:90]}" for k, v in r.items() if k not in ("ts", "pr", "tail", "turns", "cost", "rc", "model", "stage", "issue") and v not in (None, "None", ""))
            ev.append((r["ts"][:19], "ledger", f"{tag}{r.get('stage')} {bits}".strip()))
    try:
        if not str(n).isdigit():  # an issue's own build rows carry "i<issue>"; there is no PR to read
            return ev
        d = gh_json(f"pr:{n}", 45, ["pr", "view", str(n), "--json", VIEW_FIELDS])
        for c in d.get("commits") or []:
            ev.append((_local(c["committedDate"]), "commit", f"{tag}{c['oid'][:8]} {c.get('messageHeadline', '')[:100]}"))
        for c in d.get("comments") or []:
            if MARKER.search(c.get("body") or ""):
                x = note("", c["createdAt"], "comment", c.get("body"))
                ev.append((_local(c["createdAt"]), "comment", f"{tag}{x['tag']} {x['first']}"[:200]))
    except Exception:
        pass
    return ev


def runs_view(kind, n):
    if kind == "pr":
        runs = pr_runs(n)
        return dict(groups=[dict(label=f"Pull Request #{n}", runs=runs)], timeline=sorted(_timeline(n)))
    agents = _agent_rows(f"i{n}")
    groups, ev, b = [], [], WORK / "issues" / str(n)
    if (b / "brief.md").is_file():
        groups.append(dict(label="Issue Build", runs=[_run_row(f"i{n}", "issue build", b, agents)]))
    d = gh_json(f"issue:{n}", 45, ["issue", "view", str(n), "--json", IVIEW_FIELDS])
    prs = {q["number"] for q in d.get("closedByPullRequestsReferences") or []} | ({int(p)} if (p := (issue_chain(n) or {}).get("pr")) else set())
    for pn in sorted(prs):
        runs = [r for r in pr_runs(pn) if r["id"][0] == "p"]
        if runs:
            groups.append(dict(label=f"Pull Request #{pn}", runs=runs))
        ev += _timeline(pn, f"#{pn} ")
    if groups and groups[0]["label"] == "Issue Build":
        ev += _timeline(f"i{n}")
    return dict(groups=groups, timeline=sorted(ev))


def run_detail(rid):
    m = RUN_ID.fullmatch(rid)
    if not m:
        raise ValueError("bad run id")
    if m.group(3):
        d, role, pr = WORK / "issues" / m.group(3), "build", None
    else:
        pr, d = m.group(1), WORK / "prs" / m.group(1) / m.group(2)
        role = m.group(2).split(".")[0].rsplit("-", 1)[-1]
    ok_parent = (WORK / "issues") if pr is None else (WORK / "prs" / pr)
    if not (d / "brief.md").is_file() or d.resolve().parent != ok_parent.resolve():
        raise ValueError("no such run")
    cap = lambda p, k: p.read_text(errors="replace")[:k] if p.is_file() else ""
    brief = cap(d / "brief.md", 60000)
    prev = diff = ""
    if pr is not None:
        runs = pr_runs(pr)
        same = [r for r in runs if r["role"] == role]
        i = next((j for j, r in enumerate(same) if r["id"] == rid), 0)
        if i:
            pb = cap(WORK / "prs" / pr / same[i - 1]["name"] / "brief.md", 60000)
            prev = same[i - 1]["name"]
            diff = "".join(difflib.unified_diff(pb.splitlines(True), brief.splitlines(True), same[i - 1]["name"], d.name, n=1))[:60000]
    return dict(brief=brief, result=cap(d / RUN_RESULT.get(role, "verdict.md"), 40000), out=cap(d / "out.jsonl", 20000),
                diff=diff, prev=prev, same=bool(prev) and not diff,
                extra=sorted(f.name for f in d.iterdir() if f.is_file() and f.name not in ("err.txt", "brief.md", "out.jsonl", "no-gh") and f.name != RUN_RESULT.get(role)))


SPEND_PAGE = PRS_PAGE.parent / "spend.html"
WIKI_PAGE = PRS_PAGE.parent / "wiki.html"  # the loop diagram, its rules, and per-step prompt/model editing (2026-11-16)
ISSUE_REF =re.compile(r"(?:refs|fix(?:es)?|closes)\s+#(\d+)", re.I)
table_cache = {"at": 0, "data": None}


def spend_table():
    """Tokens per pull request and per issue, all time, from the ledger. An issue's figure is its build run plus every PR tied to it
    (GitHub's closing link, an issue-<n> branch name, or 'refs #n' in the PR title). Titles come from one GitHub read, cached 10 min."""
    if table_cache["data"] and time.time() - table_cache["at"] < 5:
        return table_cache["data"]
    today = time.strftime("%Y-%m-%d")
    per, days, dusd, by_model = {}, {}, {}, {}
    for r in spend_runs():
        if r["end"]:
            continue
        d = per.setdefault(r["pr"], dict(tok=0, today=0, usd=0.0, usd_today=0.0, unpriced=0, runs=0, missing=0, last="", models={}))
        tok, usd = r["tok"] or 0, r["usd"] or 0.0
        d["tok"] += tok
        d["usd"] += usd
        d["runs"] += 1
        d["missing"] += r["tok"] is None
        d["unpriced"] += r["usd"] is None
        d["last"] = max(d["last"], r["ts"])
        if r["ts"].startswith(today):
            d["today"] += tok
            d["usd_today"] += usd
        m = r.get("real") or str(r["model"]).replace("codex:", "")
        for bag in (d["models"], by_model):
            e = bag.setdefault(m, [0, 0.0])
            e[0] += tok
            e[1] += usd
        days[r["ts"][:10]] = days.get(r["ts"][:10], 0) + tok
        dusd[r["ts"][:10]] = dusd.get(r["ts"][:10], 0.0) + usd
    try:
        idx = {q["number"]: q for q in gh_json("spendidx", 600, ["pr", "list", "--state", "all", "--limit", "400", "--json",
                                                                  "number,title,state,headRefName,closingIssuesReferences"])}
    except Exception:
        idx = {}
    try:
        names = {q["number"]: q for q in gh_json("spendiss", 600, ["issue", "list", "--state", "all", "--limit", "700", "--json", "number,title,state"])}
    except Exception:
        names = {}
    prs, iss = [], {}
    for n, d in per.items():
        if isinstance(n, str):
            if n[:1] == "i" and n[1:].isdigit():
                e = iss.setdefault(int(n[1:]), dict(tok=0, today=0, usd=0.0, usd_today=0.0, prs=[], build=0))
                e["tok"] += d["tok"]
                e["today"] += d["today"]
                e["usd"] += d["usd"]
                e["usd_today"] += d["usd_today"]
                e["build"] += d["tok"]
            continue
        q = idx.get(n) or {}
        links = {i["number"] for i in q.get("closingIssuesReferences") or []}
        links |= {int(x) for x in re.findall(r"issue-(\d+)", q.get("headRefName") or "")}
        links |= {int(x) for x in ISSUE_REF.findall(q.get("title") or "")}
        links.discard(n)
        prs.append(dict(n=n, title=q.get("title", ""), state=q.get("state", ""), chain=(chain_state(n) or {}).get("status", ""),
                        issues=sorted(links), **d))
        for i in links:
            e = iss.setdefault(i, dict(tok=0, today=0, usd=0.0, usd_today=0.0, prs=[], build=0))
            e["tok"] += d["tok"]
            e["today"] += d["today"]
            e["usd"] += d["usd"]
            e["usd_today"] += d["usd_today"]
            e["prs"].append(n)
    issues = [dict(n=i, title=(names.get(i) or {}).get("title", ""), state=(names.get(i) or {}).get("state", ""), **e) for i, e in iss.items()]
    data = dict(prs=prs, issues=issues, total=sum(d["tok"] for d in per.values()), today=days.get(today, 0),
                usd=sum(d["usd"] for d in per.values()), usd_today=dusd.get(today, 0.0),
                unpriced=sum(d["unpriced"] for d in per.values()), runs=sum(d["runs"] for d in per.values()),
                models=[dict(model=k, tok=v[0], usd=v[1]) for k, v in sorted(by_model.items(), key=lambda x: -x[1][1])],
                rates=dict(rate_used), rates_at=time.strftime("%Y-%m-%d %H:%M", time.localtime(table["at"])) if table["at"] else "",
                days=[dict(day=k, tok=v, usd=dusd.get(k, 0.0)) for k, v in sorted(days.items())][-10:], since=min((r["ts"] for r in spend_runs()), default="")[:10],
                unlinked=sum(1 for q in prs if not q["issues"]))
    table_cache.update(at=time.time(), data=data)
    return data


def tok_maps():
    t = spend_table()
    return {q["n"]: q["tok"] for q in t["prs"]}, {i["n"]: i["tok"] for i in t["issues"]}


def usd_maps():
    t = spend_table()
    return {q["n"]: round(q["usd"], 2) for q in t["prs"]}, {i["n"]: round(i["usd"], 2) for i in t["issues"]}


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        path = self.path.split("?")[0]
        if (rm := re.fullmatch(r"/api/(pr|issue)/(\d+)/runs", path)):
            try:
                data = runs_view(rm.group(1), int(rm.group(2)))
            except Exception as e:
                data = {"error": str(e)[:300]}
            body, ctype = json.dumps(data).encode(), "application/json"
        elif path.startswith("/api/run/"):
            try:
                data = run_detail(path[len("/api/run/"):])
            except Exception as e:
                data = {"error": str(e)[:300]}
            body, ctype = json.dumps(data).encode(), "application/json"
        elif path == "/runs.js":
            body, ctype = RUNS_JS.read_bytes(), "text/javascript; charset=utf-8"
        elif self.path.startswith("/api/state"):
            try:
                body, ctype = json.dumps({**state(int(m.group(1)) if (m := re.search(r"[?&]pr=(\d+)", self.path)) else None), "build": BUILD}).encode(), "application/json"
            except Exception as e:  # a half-written file must not kill the page
                body, ctype = json.dumps({"error": str(e)}).encode(), "application/json"
        elif self.path.startswith("/api/issue"):
            q = self.path.split("?")
            fresh = len(q) > 1 and "fresh=1" in q[1]
            m = re.fullmatch(r"/api/issue/(\d+)", q[0])
            try:
                if m:
                    data = issue_detail(int(m.group(1)), fresh)
                else:
                    w = re.search(r"state=(\w+)", q[1]) if len(q) > 1 else None
                    data = issue_list(w.group(1) if w else "open", fresh)
            except Exception as e:
                data = {"error": str(e)[:300]}
            body, ctype = json.dumps(data).encode(), "application/json"
        elif self.path.startswith("/api/pr"):
            q = self.path.split("?")
            fresh = len(q) > 1 and "fresh=1" in q[1]
            m = re.fullmatch(r"/api/pr/(\d+)", q[0])
            dm = re.fullmatch(r"/api/pr/(\d+)/diff", q[0])
            try:
                if dm:
                    data = pr_diff(int(dm.group(1)), fresh)
                elif m:
                    data = pr_detail(int(m.group(1)), fresh)
                else:
                    w = re.search(r"state=(\w+)", q[1]) if len(q) > 1 else None
                    refresh_pick()
                    data = pr_list(w.group(1) if w else "open", fresh)
            except Exception as e:
                data = {"error": str(e)[:300]}
            body, ctype = json.dumps(data).encode(), "application/json"
        elif self.path.split("?")[0].rstrip("/") == "/api/spend":
            try:
                data = spend_table()
            except Exception as e:
                data = {"error": str(e)[:300]}
            body, ctype = json.dumps(data).encode(), "application/json"
        elif self.path.split("?")[0].rstrip("/") == "/api/flow":  # the chain's program (pr-chain/flow.json); the wiki draws it
            try:
                data = json.loads((ROOT / "chain" / "flow.json").read_text())
            except Exception as e:
                data = {"error": str(e)[:300]}
            body, ctype = json.dumps(data).encode(), "application/json"
        elif self.path.split("?")[0].rstrip("/") == "/wiki":
            body, ctype = WIKI_PAGE.read_bytes(), "text/html; charset=utf-8"
        elif self.path.split("?")[0].rstrip("/") == "/spend":
            body, ctype = SPEND_PAGE.read_bytes(), "text/html; charset=utf-8"
        elif self.path.split("?")[0].rstrip("/") == "/config":
            body, ctype = CONFIG_PAGE.read_bytes(), "text/html; charset=utf-8"
        elif self.path.split("?")[0].rstrip("/") == "/api/config":
            try:
                data = config_state()
            except Exception as e:
                data = {"error": str(e)[:300]}
            body, ctype = json.dumps(data).encode(), "application/json"
        elif self.path.split("?")[0].rstrip("/") == "/issues":
            body, ctype = ISSUES_PAGE.read_bytes(), "text/html; charset=utf-8"
        elif self.path.split("?")[0].rstrip("/") == "/prs":
            body, ctype = PRS_PAGE.read_bytes(), "text/html; charset=utf-8"
        elif self.path.startswith("/three/"):
            name = self.path.split("/")[-1].split("?")[0]
            if name not in ("three.module.js", "three.core.js") or not (VENDOR / name).exists():
                self.send_error(404)
                return
            if name not in vendor_cache:
                vendor_cache[name] = (VENDOR / name).read_bytes()
            body, ctype = vendor_cache[name], "text/javascript; charset=utf-8"
        else:
            body, ctype = PAGE.replace("__BUILD__", BUILD).encode(), "text/html; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        route = self.path.split("?")[0].rstrip("/")
        if route not in ("/api/config", "/api/loop"):
            self.send_error(404)
            return
        origin = self.headers.get("Origin")
        if not (self.headers.get("Content-Type") or "").startswith("application/json") or (
                origin and origin.split("://", 1)[-1] != (self.headers.get("Host") or "")):
            self.send_error(403, "same-origin JSON only")  # a page on another site cannot save config (audit 11-14)
            return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n).decode() or "{}")
            if not isinstance(body, dict):
                raise ValueError("body must be a JSON object")
            if route == "/api/loop":
                ok, msg = start_loop() if body.get("action") == "start" else (False, "action must be start")
                data = {} if ok else {"error": msg}
            else:
                ok, msg = apply_config(body)
                data = config_state() if ok else {"error": msg}
            data["saved"] = msg
        except Exception as e:
            ok, data = False, {"error": f"bad request: {e}"[:300]}
        payload = json.dumps(data).encode()
        self.send_response(200 if ok else 400)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8790
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()
