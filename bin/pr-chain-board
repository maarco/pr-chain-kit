#!/usr/bin/env python3
"""pr-chain-board: live page for the pr-chain loop. http://127.0.0.1:8790

Shows the PR in flight, which step it is on, the agent's latest lines, the queue of PRs that come next and the last
results. Reads only: the work folder (claims, prs/<n>/STATE.json, stage folders, ledger.jsonl, logs/loop.log) and
`pr-chain pick` (cached 3 minutes). POST /api/loop {"action":"start"} starts pr-chain-loop when it is down (the Start Loop button). The other writing surface is /config (2026-11-13): it edits
chain/models.json (backup beside it), the loop thread count (board-config.json) and the
NO-BUILD issue-building block, and saves/applies named model profiles (profiles.json); every other route is read-only.
The /config model rows render the real per-stage command through agent_cmd() loaded from the pr-chain script itself.
/prs is the pull request browser (board/prs.html): list, properties and condensed conversation, read from gh (read-only calls).
Run: pr-chain-board [port]
"""
import hashlib
import json
import shlex
import urllib.request
import os
import re
import subprocess
import sys
import shutil
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "chain"))
from config import CFG as CONF  # noqa: E402  pr-chain.toml: paths.work etc.

WORK = CONF.work
CHAIN = str(ROOT / "bin" / "pr-chain")
LOGS = [WORK / "logs" / "loop.log"]
STEPS = ["Update Branch", "Review", "Fix", "Audit", "UI Review", "Human Gate", "CI", "Merge"]
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
pick_cache = {"at": 0, "rows": [], "busy": False}
VENDOR = ROOT / "vendor" / "three"
vendor_cache = {}

# --- /config page state: models.json, thread count, issue-building block, profiles ---
PC = ROOT / "chain"
MODELS_FILE = CONF.models_file  # the same file the chain reads
CFG_FILE = Path(os.environ.get("PR_CHAIN_BOARD_CONFIG") or (CONF.board_config or WORK / "board-config.json"))
NO_BUILD = WORK / "NO-BUILD"
CONFIG_PAGE = PC / "board" / "config.html"
PROFILES_FILE = MODELS_FILE.with_name("profiles.json")
COMMANDS_FILE = MODELS_FILE.with_name("commands.json")  # named full commands; a stage value cmd:<name> runs one
# keep in sync with MODEL_ROLES in bin/pr-chain
BUILTIN_MODELS = {"review": "haiku", "fix": "haiku", "gate": "opus", "ui": "opus", "build": "haiku", "scout": "haiku"}
MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")


# The loop process itself (python running bin/pr-chain-loop), not any shell whose command text mentions it
# (11-14 21:00: a watcher shell holding that text made the watchdog skip a restart).
LOOP_PROC = r"^[^ ]*python[^ ]* -B [^ ]*bin/pr-chain-loop"

def _chain_mod():
    """Load bin/pr-chain once and cache it, so /config shows the REAL command builder."""
    mod = _chain_mod.cache
    if mod is None:
        try:
            import importlib.util
            from importlib.machinery import SourceFileLoader
            loader = SourceFileLoader("pr_chain_mod", CHAIN)
            spec = importlib.util.spec_from_loader(loader.name, loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
        except Exception as e:
            mod = False
            print(f"board: could not load pr-chain for command rendering: {e}", file=sys.stderr)
    _chain_mod.cache = mod
    return mod or None


_chain_mod.cache = None


def read_commands():
    try:
        data = json.loads(COMMANDS_FILE.read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def command_uses(name):
    """Where cmd:<name> is referenced: stage names in models.json and profile names."""
    ref = f"cmd:{name}"
    try:
        cur = json.loads(MODELS_FILE.read_text())
    except Exception:
        cur = {}
    stages = sorted(r for r, v in cur.items() if v == ref)
    profiles = sorted(n for n, p in read_profiles().items() if isinstance(p, dict) and ref in p.values())
    return stages, profiles


def validate_command(name, cmd):
    """None when valid, else the error string."""
    if not isinstance(name, str) or not NAME_RE.match(name):
        return f"bad command name: {name!r} (letters, digits, . _ -, max 32)"
    if not isinstance(cmd, str) or not cmd.strip() or len(cmd) > 4000 or "\n" in cmd or "\r" in cmd:
        return "the command must be one line, at most 4000 characters"
    if "<brief.md>" not in cmd:
        return "the command needs a <brief.md> slot; the chain puts the brief path there"
    if "astra" in cmd.lower():
        return "gpt-6-astra is banned"
    try:
        shlex.split(cmd)
    except ValueError as e:
        return f"the command does not parse: {e}"
    return None


def read_profiles():
    try:
        data = json.loads(PROFILES_FILE.read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _procs():
    try:
        out = subprocess.run(["/bin/ps", "-axo", "pid,ppid,command"], capture_output=True, text=True).stdout
    except Exception:
        return []
    rows = []
    for ln in out.splitlines()[1:]:
        parts = ln.strip().split(None, 2)
        if len(parts) == 3:
            rows.append((int(parts[0]), int(parts[1]), parts[2]))
    return rows


def running_chains():
    """Live chain processes (with their full run command) and their agent children (codex/claude descendants)."""
    rows = _procs()
    chains = {pid: cmd for pid, _ppid, cmd in rows if re.search(r"bin/pr-chain (run|land) ", cmd)}
    parent = {pid: _ppid for pid, _ppid, _cmd in rows}

    def under_chain(pid):
        seen = set()
        while pid in parent and pid not in seen:
            if pid in chains:
                return True
            seen.add(pid)
            pid = parent[pid]
        return False

    agents = 0
    for pid, _ppid, cmd in rows:
        if re.search(r"(codex|claude)", cmd) and under_chain(parent.get(pid)):
            agents += 1
    loop_cmd = next((cmd for _pid, _ppid, cmd in rows if re.search(r"bin/pr-chain-loop( |$)", cmd)), "")
    return [dict(pid=pid, cmd=cmd) for pid, cmd in sorted(chains.items())], agents, loop_cmd


def read_prs_at_once():
    """flow.json limits.prs_at_once: how many PRs pick marks free (the loop's threads only add build slots above it)."""
    try:
        v = json.loads((ROOT / "chain" / "flow.json").read_text())["limits"]["prs_at_once"]["value"]
        return v if v != -1 else None
    except (OSError, ValueError, KeyError, TypeError):
        return None


def read_threads():
    try:
        return max(1, min(4, int(json.loads(CFG_FILE.read_text())["threads"])))
    except Exception:
        return 1


PROMPT_DIR = PC / "prompts"
PROMPT_USE = {"review.md": "review and audit agents", "review-fix.md": "added to the review brief: the reviewer fixes what it fails",
              "fix.md": "plain fixer (red CI, conflicts, gate findings, your comments)", "ui-review.md": "UI screenshot reviewer",
              "addendum.md": "merge-only addendum after main moves", "build.md": "issue builder", "scout.md": "issue scout"}


def prompt_files():
    return sorted(f for f in PROMPT_DIR.glob("*.md") if f.is_file())


def config_state():
    models = {}
    cfg = {}
    if MODELS_FILE.exists():
        try:
            cfg = json.loads(MODELS_FILE.read_text())
        except Exception:
            cfg = {}
    chain = _chain_mod()
    commands, labels = {}, {}
    for role, builtin in BUILTIN_MODELS.items():
        env = os.environ.get(f"PR_CHAIN_{role.upper()}_MODEL")
        if env:
            models[role] = [env, f"env PR_CHAIN_{role.upper()}_MODEL"]
        elif cfg.get(role):
            models[role] = [cfg[role], str(MODELS_FILE)]
        else:
            models[role] = [builtin, "built-in"]
        if chain is not None:
            try:
                val = models[role][0]
                named = read_commands().get(val[4:]) if val.startswith("cmd:") else None
                commands[role] = named if isinstance(named, str) else shlex.join(chain.agent_cmd(val))
                labels[role] = chain.cmd_label(commands[role]) if hasattr(chain, "cmd_label") else val
            except (Exception, SystemExit) as e:
                commands[role] = f"(cannot render: {e})"
        else:
            commands[role] = "(pr-chain script did not load; see board log)"
    file_map = {k: str(v) for k, v in sorted(cfg.items()) if k in BUILTIN_MODELS}
    profiles = [{"name": n, "models": p, "active": p == file_map}
                for n, p in sorted(read_profiles().items())]
    chains, agents, loop_cmd = running_chains()
    return {"prompts": [dict(name=f.name, text=f.read_text(), use=PROMPT_USE.get(f.name, "")) for f in prompt_files()],
            "models": models, "builtins": BUILTIN_MODELS, "models_file": str(MODELS_FILE),
            "commands": commands, "labels": labels, "profiles": profiles,
            "named": {n: {"cmd": c, "uses": dict(zip(("stages", "profiles"), command_uses(n)))}
                      for n, c in sorted(read_commands().items())},
            "threads": read_threads(), "prs_at_once": read_prs_at_once(), "build_issues": not NO_BUILD.exists(),
            "running": {"chains": len(chains), "agents": agents, "loop_cmd": loop_cmd, "chain_cmds": chains}}


def write_atomic(path, text):
    tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
    tmp.write_text(text)
    os.replace(tmp, path)


def validate_models(m):
    """None when valid, else the error string."""
    if not isinstance(m, dict) or set(m) - set(BUILTIN_MODELS):
        return "models must hold only: " + ", ".join(sorted(BUILTIN_MODELS))
    for role, val in m.items():
        if not isinstance(val, str) or not MODEL_RE.match(val):
            return f"bad model name for {role}: {val!r}"
    if any("astra" in str(v).lower() for v in m.values()):
        return "gpt-6-astra is banned"
    names = read_commands()
    for role, val in m.items():
        if val.startswith("cmd:") and val[4:] not in names:
            return f"{role}: no command named {val[4:]!r}"
    return None


def backup_models():
    if MODELS_FILE.exists():
        bak = MODELS_FILE.with_name(f"models.json.bak-{time.strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(MODELS_FILE, bak)


def write_models(m):
    """Write a full role->model map (empty values drop the role)."""
    backup_models()
    cur = {}
    if MODELS_FILE.exists():
        try:
            cur = json.loads(MODELS_FILE.read_text())
        except Exception:
            cur = {}
    cur.update({k: v for k, v in m.items() if v})
    for k, v in m.items():
        if not v:
            cur.pop(k, None)
    write_atomic(MODELS_FILE, json.dumps(cur, indent=2, sort_keys=True) + "\n")


def apply_config(body):
    """Validate and apply one POST from the config page. Returns (ok, saved-message).

    Profile operations run first and return before anything else writes, so a rejected
    request never touches models.json."""
    saved = []
    if "save_prompt" in body:  # a stage brief; the old text is kept in prompts/.history, and no {{SLOT}} may disappear
        c = body["save_prompt"] if isinstance(body["save_prompt"], dict) else {}
        name, text = c.get("name"), c.get("text")
        f = PROMPT_DIR / str(name)
        if not isinstance(name, str) or f not in prompt_files():
            return False, "unknown prompt file"
        if not isinstance(text, str) or not text.strip():
            return False, "a prompt cannot be empty"
        old = f.read_text()
        gone = sorted(set(re.findall(r"\{\{[A-Z_]+\}\}", old)) - set(re.findall(r"\{\{[A-Z_]+\}\}", text)))
        if gone:
            return False, "the chain fills these slots and they are missing now: " + ", ".join(gone)
        hist = PROMPT_DIR / ".history"
        hist.mkdir(exist_ok=True)
        (hist / f"{name}.{time.strftime('%Y%m%d-%H%M%S')}").write_text(old)
        write_atomic(f, text if text.endswith("\n") else text + "\n")
        return True, f"prompt saved: {name} (old copy in prompts/.history)"
    if "save_command" in body:
        c = body["save_command"] if isinstance(body["save_command"], dict) else {}
        name, cmd = c.get("name"), (c.get("cmd") or "").strip() if isinstance(c.get("cmd"), str) else c.get("cmd")
        err = validate_command(name, cmd)
        if err:
            return False, err
        cmds = read_commands()
        existed = name in cmds
        cmds[name] = cmd
        write_atomic(COMMANDS_FILE, json.dumps(cmds, indent=2, sort_keys=True) + "\n")
        saved.append(f"command {'updated' if existed else 'added'}: {name}")
        return True, "; ".join(saved)
    if "delete_command" in body:
        name = body["delete_command"]
        cmds = read_commands()
        if not isinstance(name, str) or name not in cmds:
            return False, f"no such command: {name!r}"
        stages, profs = command_uses(name)
        if stages or profs:
            return False, f"{name} is still used by " + ", ".join(
                ([f"stages {', '.join(stages)}"] if stages else []) + ([f"profiles {', '.join(profs)}"] if profs else []))
        del cmds[name]
        write_atomic(COMMANDS_FILE, json.dumps(cmds, indent=2, sort_keys=True) + "\n")
        return True, f"command deleted: {name}"
    if "save_profile" in body:
        name = body["save_profile"]
        if not isinstance(name, str) or not NAME_RE.match(name):
            return False, f"bad profile name: {name!r} (letters, digits, . _ -, max 32)"
        err = validate_models(body.get("models"))
        if err:
            return False, f"profile needs models: {err}"
        profiles = read_profiles()
        existed = name in profiles
        profiles[name] = {k: v for k, v in sorted(body["models"].items()) if v}
        write_atomic(PROFILES_FILE, json.dumps(profiles, indent=2, sort_keys=True) + "\n")
        saved.append(f"profile {'overwrote' if existed else 'saved'}: {name}")
    if "apply_profile" in body:
        name = body["apply_profile"]
        profiles = read_profiles()
        if not isinstance(name, str) or name not in profiles:
            return False, f"no such profile: {name!r}"
        write_models(profiles[name])
        saved.append(f"applied profile {name} -> models.json")
    if "delete_profile" in body:
        name = body["delete_profile"]
        profiles = read_profiles()
        if not isinstance(name, str) or name not in profiles:
            return False, f"no such profile: {name!r}"
        del profiles[name]
        write_atomic(PROFILES_FILE, json.dumps(profiles, indent=2, sort_keys=True) + "\n")
        saved.append(f"profile deleted: {name}")
    if "models" in body and "save_profile" not in body:
        err = validate_models(body["models"])
        if err:
            return False, err
        write_models(body["models"])
        m = body["models"]
        saved.append(f"models -> {', '.join(f'{k}={m[k]}' for k in sorted(m) if m[k])}" + (f", cleared {', '.join(k for k in m if not m[k])}" if any(not v for v in m.values()) else ""))
    if "threads" in body:
        t = body["threads"]
        if not isinstance(t, int) or isinstance(t, bool) or not 1 <= t <= 4:
            return False, "threads must be an integer 1-4"
        cur = {}
        if CFG_FILE.exists():
            try:
                cur = json.loads(CFG_FILE.read_text())
            except Exception:
                cur = {}
        cur["threads"] = t
        write_atomic(CFG_FILE, json.dumps(cur, indent=2) + "\n")
        saved.append(f"threads -> {t}")
    if "build_issues" in body:
        want = body["build_issues"]
        if not isinstance(want, bool):
            return False, "build_issues must be true or false"
        if want:
            NO_BUILD.unlink(missing_ok=True)
            saved.append("issue building allowed")
        else:
            NO_BUILD.write_text("issue building blocked from the board /config page\n")
            saved.append("issue building blocked")
    return True, "; ".join(saved)


def start_loop():
    """Board Start Loop button (2026-11-16): start pr-chain-loop the way its README row does, detached and appending to
    logs/loop.log. Clears a STOP file first (pressing Start means run). No-op when the loop already runs."""
    if subprocess.run(["/usr/bin/pgrep", "-f", LOOP_PROC], capture_output=True, text=True).stdout.strip():
        return True, "loop already running"
    (WORK / "STOP").unlink(missing_ok=True)
    env = {k: v for k, v in os.environ.items() if k not in ("VIRTUAL_ENV", "PYTHONHOME", "PYTHONPATH")}  # never a repo .venv
    (WORK / "logs").mkdir(parents=True, exist_ok=True)
    with open(WORK / "logs" / "loop.log", "a") as fh:  # own session: a board restart never takes the loop down with it
        subprocess.Popen([sys.executable, "-B", str(ROOT / "bin" / "pr-chain-loop")], stdout=fh,
                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, cwd=str(ROOT), env=env, start_new_session=True)
    return True, "loop started"


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


def tail(path, size=8000):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            n = fh.tell()
            fh.seek(max(0, n - size))
            return fh.read().decode("utf-8", "replace")
    except OSError:
        return ""


def log_lines(path=None):
    """Narrative lines ("[" first) from `path`, else from the newest of LOGS."""
    live = [path] if path else [p for p in LOGS if p.exists()]
    if not live:
        return []
    p = max(live, key=lambda x: x.stat().st_mtime)
    return [ln for ln in tail(p, 20000).splitlines() if ln.startswith("[")]


def step_of(text):
    t = text.lower()
    for pat, step in ((r"\bmerged\b|approver|land", "Merge"), (r"\bci\b|checks", "CI"), (r"human|screenshots posted", "Human Gate"),
                      (r"\bui\b|vision", "UI Review"), (r"addendum|gate|audit", "Audit"), (r"fix|push", "Fix"),
                      (r"review", "Review"), (r"fold|behind|update-branch|drift", "Update Branch")):
        if re.search(pat, t):
            return step
    return None


MARK = {"codex": "say", "exec": "run", "thinking": "think", "user": "skip"}
ENVVAR = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=\S+\s+")


def clean_cmd(s):
    s = re.sub(r"^/bin/(zsh|bash|sh) -l?c\s+", "", s).lstrip("'\"")
    s = re.sub(r"^set -o pipefail;\s*", "", s)
    while ENVVAR.match(s):
        s = ENVVAR.sub("", s, count=1)
    s = re.sub(re.escape(str(WORK)) + r"/prs/\d+/[^/]+/wt/?", "", s)
    s = re.sub(r"\S*" + re.escape(str(CONF.worktree_root)) + r"/[^/\s]+/?", "", s).replace(str(Path.home()), "~")
    return s[:240]


def events(raw):
    """Codex transcript lines -> [{k: say|think|run|out|tool, t: text}]."""
    ev, mode, fresh, outn = [], None, False, 0
    for ln in raw:
        s = ln.strip()
        if not s:
            continue
        if s in MARK:
            mode, fresh = MARK[s], True
            continue
        if s.startswith("mcp: "):
            if s.endswith(")"):
                name = s[5:].split(" ")[0].split("/")[-1]
                if ev and ev[-1]["k"] == "tool":
                    ev[-1]["n"].append(name)
                else:
                    ev.append({"k": "tool", "n": [name]})
            mode = None
            continue
        if s.startswith("tokens used"):
            mode = None
            continue
        if mode in ("say", "think"):
            if not fresh and ev and ev[-1]["k"] == mode:
                ev[-1]["t"] = (ev[-1]["t"] + "\n" + s)[:1600]
            else:
                ev.append({"k": mode, "t": s[:1600]})
            fresh = False
        elif mode == "run":
            if fresh:
                ev.append({"k": "run", "t": clean_cmd(s)})
                fresh, outn = False, 0
            elif re.fullmatch(r"succeeded in [\d.]+m?s:", s):
                continue
            elif outn < 3:
                ev.append({"k": "out", "t": s.replace(str(Path.home()), "~")[:200]})
                outn += 1
    for e in ev:
        if e["k"] == "tool":
            names = e.pop("n")
            e["t"] = ", ".join(f"{n} x{names.count(n)}" if names.count(n) > 1 else n for n in dict.fromkeys(names))
    return ev


def stream_events(raw):
    """claude -p --output-format stream-json lines -> the same [{k, t}] shape as events(); hook/system lines are skipped."""
    ev, outn = [], 3
    for ln in raw:
        if not ln.startswith('{"type":"assistant"') and not ln.startswith('{"type":"user"'):
            continue
        try:
            msg = json.loads(ln).get("message") or {}
        except ValueError:
            continue
        for c in msg.get("content") or []:
            if not isinstance(c, dict):
                continue
            k = c.get("type")
            if k == "text" and c.get("text", "").strip():
                ev.append({"k": "say", "t": c["text"].strip()[:1600]})
            elif k == "thinking" and c.get("thinking", "").strip():
                ev.append({"k": "think", "t": c["thinking"].strip()[:1600]})
            elif k == "tool_use":
                inp = c.get("input") or {}
                if c.get("name") == "Bash" and inp.get("command"):
                    ev.append({"k": "run", "t": clean_cmd(inp["command"])}); outn = 0
                else:
                    arg = inp.get("file_path") or inp.get("pattern") or inp.get("path") or ""
                    ev.append({"k": "tool", "t": f"{c.get('name')} {str(arg).replace(str(Path.home()), '~')}".strip()[:200]}); outn = 3
            elif k == "tool_result" and outn < 3:
                body = c.get("content")
                if isinstance(body, list):
                    body = "\n".join(x.get("text", "") for x in body if isinstance(x, dict))
                for line in str(body or "").splitlines():
                    if line.strip() and outn < 3:
                        ev.append({"k": "out", "t": line.strip().replace(str(Path.home()), "~")[:200]}); outn += 1
    return ev


def log_epoch(line):
    """[HH:MM:SS] at the start of a log line -> epoch seconds (today, or yesterday if that would be in the future)."""
    m = re.match(r"\[(\d\d):(\d\d):(\d\d)\]", line)
    if not m:
        return 0.0
    t = time.localtime()
    e = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, int(m[1]), int(m[2]), int(m[3]), 0, 0, -1))
    return e - 86400 if e > time.time() + 60 else e


def refresh_pick():
    if pick_cache["busy"] or time.time() - pick_cache["at"] < 180:
        return
    pick_cache["busy"] = True

    def work():
        try:
            out = subprocess.run([sys.executable, "-B", CHAIN, "pick", "--all"], capture_output=True, text=True, timeout=120).stdout
            rows = []
            for ln in out.splitlines():
                m = re.match(r"^\s*(\d+)\s+(\d+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(.*)$", ln)
                if m:
                    rows.append(dict(pr=int(m.group(1)), size=int(m.group(2)), state=m.group(3), ui=m.group(4) == "UI",
                                     author=m.group(5), owner=m.group(6).strip()))
            pick_cache["rows"] = rows
        except Exception:
            pass
        pick_cache["at"] = time.time()
        pick_cache["busy"] = False
    threading.Thread(target=work, daemon=True).start()


def ledger_rows(n=400):
    rows = []
    for ln in tail(WORK / "ledger.jsonl", 200000).splitlines()[-n:]:
        try:
            rows.append(json.loads(ln))
        except ValueError:
            pass
    return rows


TOK_CODEX = re.compile(r"tokens used\s*\n?\s*([\d,]+)")
tok_cache = {}
spend_cache = {"key": None, "runs": []}


RATES_FILE = ROOT / "chain" / "rates.json"
CODEX_SID = re.compile(r"session id:\s*([0-9a-f-]{36})")
rates_cache = {"at": 0.0, "key": None, "data": {}}
rollouts = {"at": 0.0, "map": {}}


LITELLM_URL = "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
LITELLM_FILE = WORK / "litellm-rates.json"
table = {"at": 0.0, "data": {}, "new": None, "busy": False, "tried": 0.0, "loaded": False}
rate_used = {}


def table_parse(doc):
    """LiteLLM's price document as dollars per million tokens per model. An entry with no input or output rate is dropped.
    A bare model name is added only when no entry has that exact name and every provider-prefixed entry agrees on the rate."""
    num = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
    out = {}
    for name, e in (doc.items() if isinstance(doc, dict) else []):
        if not isinstance(e, dict) or not num(e.get("input_cost_per_token")) or not num(e.get("output_cost_per_token")):
            continue
        i, r, w = e["input_cost_per_token"], e.get("cache_read_input_token_cost"), e.get("cache_creation_input_token_cost")
        out[name.strip().lower()] = dict(input=round(i * 1e6, 6), cached_input=round((r if num(r) else i) * 1e6, 6),
                                         cache_write=round((w if num(w) else i) * 1e6, 6),
                                         output=round(e["output_cost_per_token"] * 1e6, 6))
    alias = {}
    for k, v in out.items():
        b = k.rsplit("/", 1)[-1]
        if b != k and b not in out:
            alias[b] = v if b not in alias else (alias[b] if alias[b] == v else None)
    out.update({k: v for k, v in alias.items() if v})
    return out


def table_fetch():
    """Background thread: download the price table, keep a slim copy on disk. A failed download keeps the old table."""
    try:
        req = urllib.request.Request(LITELLM_URL, headers={"User-Agent": "rate-table-reader"})
        data = table_parse(json.loads(urllib.request.urlopen(req, timeout=60).read()))
        if len(data) > 100:
            tmp = LITELLM_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps({"fetched": time.time(), "source": LITELLM_URL, "rates": data}))
            os.replace(tmp, LITELLM_FILE)
            table["new"] = (time.time(), data)
    except Exception:
        pass
    table["busy"] = False


def rates():
    """Hand-entered dollars per million tokens per model, from rates.json; these win over the downloaded table.
    Also keeps the downloaded LiteLLM table fresh (once a day, in the background). Checked at most once a minute."""
    if time.time() - rates_cache["at"] > 60:
        rates_cache["at"] = time.time()
        changed = False
        try:
            st = RATES_FILE.stat()
            if rates_cache["key"] != (st.st_mtime_ns, st.st_size):
                raw = json.loads(RATES_FILE.read_text())
                rates_cache.update(key=(st.st_mtime_ns, st.st_size), data={k: v for k, v in raw.items() if isinstance(v, dict)})
                changed = True
        except (OSError, ValueError):
            pass
        if not table["loaded"]:
            table["loaded"] = True
            try:
                j = json.loads(LITELLM_FILE.read_text())
                table.update(at=float(j["fetched"]), data=j["rates"])
                changed = True
            except (OSError, ValueError, KeyError, TypeError):
                pass
        if table["new"]:
            (table["at"], table["data"]), table["new"] = table["new"], None
            changed = True
        if time.time() - table["at"] > 86400 and not table["busy"] and time.time() - table["tried"] > 3600:
            table.update(busy=True, tried=time.time())
            threading.Thread(target=table_fetch, daemon=True).start()
        if changed:
            tok_cache.clear()
            rate_used.clear()
            spend_cache["key"] = None
    return rates_cache["data"]


def override_for(model):
    """A rate entered by hand in rates.json, matched by name prefix."""
    m = re.sub(r"\[.*$", "", str(model).strip().lower())
    hit = [k for k in rates() if m.startswith(k.lower())]
    if not hit:
        return None
    rate_used[m] = dict(rates()[max(hit, key=len)], src="rates.json")
    return rates()[max(hit, key=len)]


def table_for(model):
    """A rate from the downloaded LiteLLM table, by exact model name. Bare family names are never priced."""
    m = re.sub(r"\[.*$", "", str(model).strip().lower())
    r = None if m in ("opus", "sonnet", "haiku", "fable", "synthetic", "<synthetic>") else table["data"].get(m)
    if r:
        rate_used[m] = dict(r, src="litellm")
    return r


def rate_for(model):
    return override_for(model) or table_for(model)


def priced(rate, fresh, cached, write, out):
    return (fresh * rate.get("input", 0) + cached * rate.get("cached_input", 0) + write * rate.get("cache_write", 0)
            + out * rate.get("output", 0)) / 1e6


def codex_rollout(sid):
    """The Codex session file for one session id. The folder is walked once, and again (at most once a minute) for an unknown id."""
    if sid not in rollouts["map"] and time.time() - rollouts["at"] > 60:
        rollouts["at"] = time.time()
        for root, _, files in os.walk(Path.home() / ".codex/sessions"):
            for fn in files:
                m = re.search(r"([0-9a-f]{8}-[0-9a-f-]{27})\.jsonl$", fn)
                if m:
                    rollouts["map"][m.group(1)] = os.path.join(root, fn)
    return rollouts["map"].get(sid)


def codex_usage(text):
    """Codex's own running total for the session: input, cached input, cache writes, output. None when the session file is gone."""
    m = CODEX_SID.search(text)
    f = codex_rollout(m.group(1)) if m else None
    if not f:
        return None
    last = None
    try:
        with open(f, errors="replace") as fh:
            for ln in fh:
                if '"total_token_usage"' in ln:
                    last = ln
        hit = re.search(r'"total_token_usage"\s*:\s*(\{[^{}]*\})', last or "")
        return json.loads(hit.group(1)) if hit else None
    except (OSError, ValueError):
        return None


def run_usage(row):
    """(tokens, dollars) for one finished agent run; either is None when its log holds no figure.
    Tokens. Codex: the 'tokens used' line (fresh input + output). Claude: input + cache writes + output (cache reads left out).
    Dollars are an API-equivalent estimate, never a charge. Codex: its session totals times the model rate, cached input at the
    cached rate. Claude harness: the dollar figure it reports per model, except a model listed in rates.json, priced from its token
    classes. A rate is the rates.json entry when there is one, otherwise the downloaded LiteLLM table."""
    codex = str(row.get("model", "")).startswith("codex")
    name = "err.txt" if codex else "out.jsonl"
    try:
        at = time.mktime(time.strptime(row.get("ts", ""), "%Y-%m-%dT%H:%M:%S"))
        d = Path(row.get("dir", ""))
        near = [(abs(f.stat().st_mtime - at), f) for c in d.parent.iterdir() if c.name == d.name or c.name.startswith(d.name + ".")
                for f in [c / name] if f.exists()]
    except (OSError, ValueError):
        return None, None, ""
    near = [x for x in near if x[0] < 600]
    if not near:
        return None, None, ""
    f = min(near, key=lambda x: x[0])[1]
    st = f.stat()
    rates()
    key = (str(f), st.st_mtime_ns, st.st_size)
    if key not in tok_cache:
        val = usd = None
        real = ""
        text = f.read_text(errors="replace")
        if codex:
            m = TOK_CODEX.findall(text)
            val = int(m[-1].replace(",", "")) if m else None
            u, rate = codex_usage(text), rate_for(str(row.get("model", "")).replace("codex:", ""))
            if u and rate:
                cached = int(u.get("cached_input_tokens") or 0)
                usd = priced(rate, max(int(u.get("input_tokens") or 0) - cached, 0), cached,
                             int(u.get("cache_write_input_tokens") or 0), int(u.get("output_tokens") or 0))
        else:
            for ln in reversed(text.splitlines()):
                if '"type":"result"' in ln.replace(" ", ""):
                    try:
                        j = json.loads(ln)
                        u = j.get("usage") or {}
                        val = sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_creation_input_tokens", "output_tokens"))
                        mu = j.get("modelUsage") or {}
                        if mu:
                            usd = 0.0
                            top = max(mu, key=lambda k: int(mu[k].get("outputTokens") or 0))
                            real = re.sub(r"\[.*?\]$", "", top).replace("claude-", "")
                            for mname, x in mu.items():
                                rate = override_for(mname) or (None if x.get("costUSD") is not None else table_for(mname))
                                usd += priced(rate, int(x.get("inputTokens") or 0), int(x.get("cacheReadInputTokens") or 0),
                                              int(x.get("cacheCreationInputTokens") or 0), int(x.get("outputTokens") or 0)) \
                                    if rate else float(x.get("costUSD") or 0)
                        elif j.get("total_cost_usd") is not None:
                            usd = float(j["total_cost_usd"])
                    except (ValueError, TypeError, AttributeError):
                        pass
                    break
        tok_cache[key] = (val, usd, real)
    return tok_cache[key]


def spend_runs():
    """Every ledger row that is an agent run or a chain end, each agent run with its token count. Rebuilt when the ledger grows."""
    f = WORK / "ledger.jsonl"
    try:
        st = f.stat()
    except OSError:
        return []
    key = (st.st_mtime_ns, st.st_size)
    rates()
    if spend_cache["key"] != key:
        runs = []
        for ln in f.read_text(errors="replace").splitlines():
            try:
                r = json.loads(ln)
            except ValueError:
                continue
            if r.get("stage") == "agent":
                runs.append(dict(pr=r.get("pr"), ts=r.get("ts", ""), end=False, role=r.get("role", ""), model=r.get("model", ""),
                                 **dict(zip(("tok", "usd", "real"), run_usage(r)))))
            elif r.get("stage") == "end":
                runs.append(dict(pr=r.get("pr"), ts=r.get("ts", ""), end=True))
        spend_cache.update(key=key, runs=runs)
    return spend_cache["runs"]


def spend(cur=None, started=""):
    """Token totals: today, per PR (all time), per finished chain run (keyed pr + end time), and the PR in flight."""
    today = time.strftime("%Y-%m-%d")
    out = dict(today=0, today_usd=0.0, today_runs=0, today_missing=0, by_pr={}, by_end={}, by_end_usd={}, cur=0, cur_usd=0.0, cur_runs=[])
    open_run, open_usd = {}, {}
    for r in spend_runs():
        pr = r["pr"]
        if r["end"]:
            out["by_end"][f"{pr}@{r['ts']}"] = open_run.pop(pr, 0)
            out["by_end_usd"][f"{pr}@{r['ts']}"] = round(open_usd.pop(pr, 0.0), 4)
            continue
        tok, usd = r["tok"], r["usd"] or 0.0
        if r["ts"].startswith(today):
            out["today_runs"] += 1
            out["today_missing"] += tok is None
            out["today"] += tok or 0
            out["today_usd"] += usd
        out["by_pr"][pr] = out["by_pr"].get(pr, 0) + (tok or 0)
        open_run[pr] = open_run.get(pr, 0) + (tok or 0)
        open_usd[pr] = open_usd.get(pr, 0.0) + usd
        if cur is not None and pr == cur and r["ts"] >= started:
            out["cur"] += tok or 0
            out["cur_usd"] += usd
            out["cur_runs"].append(dict(role=r["role"], model=r["model"], tok=tok, usd=r["usd"], ts=r["ts"][11:16]))
    return out


LEDGER_STEP = {"fold": "Update Branch", "update-branch": "Update Branch", "drift": "Update Branch", "verdict": "Review", "fix": "Fix",
               "push": "Fix", "audit": "Audit", "addendum": "Audit", "ui-review": "UI Review", "ui-verdict": "UI Review", "ui-fix": "UI Review",
               "land": "Merge"}


def lane_info(n, led):
    """A running chain other than the featured one: where it is and what it finished, for one row of the graphic."""
    try:
        st = json.loads((WORK / "prs" / str(n) / "STATE.json").read_text())
    except (OSError, ValueError):
        st = {}
    rl = WORK / "logs" / f"run-{n}.log"
    mine = [ln for ln in log_lines(rl if rl.exists() else None) if f"#{n} " in ln]
    step = step_of(mine[-1].split("] ", 1)[-1]) if mine else None
    started = st.get("started", "")
    done = [dict(step=LEDGER_STEP[r["stage"]], verdict=r.get("verdict") or r.get("status") or "", ts=r.get("ts", "")[11:16])
            for r in led if r.get("pr") == n and r.get("ts", "") >= started and r.get("stage") in LEDGER_STEP]
    row = next((q for q in pick_cache["rows"] if q["pr"] == n), {})
    return dict(pr=n, step=step, round=st.get("round"), ui=row.get("ui", False), done=done)


def state(pick_pr=None):
    refresh_pick()
    cur, since, live = None, 0.0, []
    claims = WORK / "claims"
    if claims.exists():
        for c in claims.iterdir():
            pidf = c / "pid"
            if c.name.isdigit() and pidf.exists() and alive(pidf.read_text().strip()):
                live.append((pidf.stat().st_mtime, int(c.name)))
    if live:
        since, cur = max(live)
        chosen = [x for x in live if x[1] == pick_pr]  # the board's PR toggle: show that chain's agent instead of the newest
        if chosen:
            since, cur = chosen[0]
    out_live = sorted(n for _, n in live)
    loop_on = bool(subprocess.run(["/usr/bin/pgrep", "-f", LOOP_PROC], capture_output=True, text=True).stdout.strip())
    chain_on = bool(subprocess.run(["/usr/bin/pgrep", "-f", r"bin/pr-chain (auto|run|land|resume)"], capture_output=True, text=True).stdout.strip())
    # the loop sends each chain's output to logs/run-<pr>.log: show it once this chain has written there, else loop.log as before
    run_log = WORK / "logs" / f"run-{cur}.log"
    lines = log_lines(run_log if cur is not None and run_log.exists() and run_log.stat().st_mtime >= since else None)
    led = ledger_rows()
    out = dict(now=time.strftime("%H:%M:%S"), loop_on=loop_on, chain_on=chain_on, stop=(WORK / "STOP").exists(), steps=STEPS,
               log=[ln[:220] for ln in lines[-60:]], current=None, queue=pick_cache["rows"], pick_age=int(time.time() - pick_cache["at"]))
    sp = spend()
    out["tok"] = dict(today=sp["today"], usd=round(sp["today_usd"], 2), runs=sp["today_runs"], missing=sp["today_missing"])
    try:  # pr-chain doctor's last findings (it runs every loop lap)
        out["problems"] = json.loads((WORK / "doctor.json").read_text()).get("rows", [])
    except (OSError, ValueError):
        out["problems"] = []
    out["ended"] = [dict(pr=r.get("pr"), status=r.get("status"), why=(r.get("why") or "")[:140], ts=r.get("ts", "")[5:16].replace("T", " "),
                         tok=sp["by_end"].get(f"{r.get('pr')}@{r.get('ts', '')}", 0),
                         usd=sp["by_end_usd"].get(f"{r.get('pr')}@{r.get('ts', '')}", 0))
                    for r in led if r.get("stage") == "end"][-40:][::-1]
    today = time.strftime("%Y-%m-%d")
    out["drift_today"] = sum(1 for r in led if r.get("stage") in ("drift", "addendum") and r.get("ts", "").startswith(today))
    out["live"] = out_live
    out["building"] = None  # the loop's issue builds (pr-chain auto, up to 3): which issues, while a build process lives
    out["build_lanes"] = []
    if subprocess.run(["/usr/bin/pgrep", "-f", r"bin/pr-chain (auto|issue)"], capture_output=True).returncode == 0:
        nums = []
        for bl in sorted((WORK / "logs").glob("run-build*.log")):
            if time.time() - bl.stat().st_mtime < 3 * 3600:
                hits = re.findall(r"#i(\d+) ", tail(bl, 4000))
                if hits and int(hits[-1]) not in nums:
                    nums.append(int(hits[-1]))
        out["building"] = nums[0] if nums else 0
        out["building_all"] = nums
        out["build_lanes"] = [dict(pr=n, label=f"issue #{n}", step="Fix", ui=False, done=[]) for n in nums]
    out["lanes"] = [lane_info(n, led) for _, n in sorted(live, reverse=True) if n != cur]  # the other running chains
    out["lanes"] += out.get("build_lanes", [])
    # doctor rows go stale while chains run (it runs inside resume): drop the ones the live state already answers
    out["problems"] = [r for r in out.get("problems", []) if not (r.get("pr") in out_live and r.get("kind") == "dead-chain")
                       and not (r.get("kind") == "loop-down" and out.get("loop_on"))]
    if cur is None:
        return out
    d = WORK / "prs" / str(cur)
    st = {}
    try:
        st = json.loads((d / "STATE.json").read_text())
    except Exception:
        pass
    mine = [ln for ln in lines if f"#{cur} " in ln]
    step = step_of(mine[-1].split("] ", 1)[-1]) if mine else None
    stage_dirs = sorted([p for p in d.iterdir() if p.is_dir() and ".old" not in p.name], key=lambda p: p.stat().st_mtime)
    agent = dict(dir="", events=[], idle=None, role="")
    if stage_dirs:
        sd = stage_dirs[-1]
        # the agent's transcript is the bigger of the two: Codex streams to err.txt, claude -p streams stream-json to
        # out.jsonl (its err.txt holds only startup warnings)
        cands = [f for f in (sd / "err.txt", sd / "out.jsonl") if f.exists() and f.stat().st_size]
        src = max(cands, key=lambda f: f.stat().st_size) if cands else sd / "out.jsonl"
        if src.name == "out.jsonl" and src.open("rb").read(1) == b"{":
            ev = stream_events(tail(src, 1500000).splitlines()[1:])  # hook lines dominate the file; read deep
        else:
            ev = events([ANSI.sub("", ln) for ln in tail(src, 60000).splitlines()][1:])
        agent = dict(dir=sd.name, events=ev[-45:], role=sd.name.split("-")[-1],
                     idle=int(time.time() - src.stat().st_mtime) if src.exists() else None)
        # the newest of the last log line and the agent's own file says where the chain is
        if step is None or (src.exists() and src.stat().st_mtime > log_epoch(mine[-1]) + 5):
            step = "UI Review" if re.match(r"r\d+u\d+-", sd.name) else \
                {"review": "Review", "fix": "Fix", "gate": "Audit", "ui": "UI Review"}.get(agent["role"])
    started = st.get("started", "")
    done = []
    for r in led:
        if r.get("pr") == cur and r.get("ts", "") >= started:
            s = LEDGER_STEP.get(r.get("stage"))
            if s:
                done.append(dict(step=s, verdict=r.get("verdict") or r.get("status") or "", ts=r.get("ts", "")[11:16]))
    title = ""
    for sd in stage_dirs:
        pm = sd / "pr.md"
        if pm.exists():
            title = pm.read_text().splitlines()[0].lstrip("# ").strip()[:120]
            break
    row = next((q for q in pick_cache["rows"] if q["pr"] == cur), {})
    out["current"] = dict(pr=cur, title=title, step=step, round=st.get("round"), head=(st.get("head") or "")[:8], started=started[11:16],
                          ui=row.get("ui", False), agent=agent, done=done)
    sp = spend(cur, started)
    out["current"].update(tok=sp["cur"], usd=round(sp["cur_usd"], 2), tok_runs=sp["cur_runs"])
    return out


