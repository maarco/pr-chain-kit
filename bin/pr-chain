CHAIN_LABELS = {k: v["label"] for k, v in FLOW["end_states"].items() if v.get("label")}  # a parked PR shows why on GitHub
NEEDS_PERSON_LABEL = FLOW["needs_person_label"]
TRUSTED = CFG.trusted          # only these accounts can approve or give feedback at the human gate
EXCLUDE_ISSUES = WORK / "exclude-issues.txt"  # lines: "<issue> <reason>"
BLOCK_LABELS = set(CFG.block_labels)
UI_SHOOT = CFG.ui_shoot_script
