# The loop process itself (python running bin/pr-chain-loop), not any shell whose command text mentions it
# (11-14 21:00: a watcher shell holding that text made the watchdog skip a restart).
LOOP_PROC = r"^[^ ]*python[^ ]* -B [^ ]*bin/pr-chain-loop"


def loop_alive(pat=LOOP_PROC):
    """Is the loop process running? The doctor asks from inside `resume`, a child of the loop, and macOS pgrep leaves a
    caller's ancestors out of its matches unless given -a: without it every doctor pass logged "loop is not running" (days of rows)."""
    return not sh("pgrep", "-a", "-f", pat).returncode


def wt_for(d):
    """The worktree for one stage folder: prs/1090/r1-review -> <WT_ROOT>/pr-1090-r1-review, issues/7 -> issue-7."""
    parts = Path(d).relative_to(WORK).parts
    kind = {"prs": "pr", "issues": "issue"}.get(parts[0], parts[0])
    return WT_ROOT / "-".join((kind,) + parts[1:])


def retire_wt(d):
    """Before a stage folder is renamed aside: drop its worktree, or move a dirty one aside the same way."""
    wt = wt_for(d)
    if wt.exists():
        drop_wt(wt)
    if wt.exists():
        sh("git", "-C", str(CHECKOUT), "worktree", "move", str(wt), str(wt.with_name(wt.name + f".old{int(time.time())}")))
WORK.mkdir(parents=True, exist_ok=True)
